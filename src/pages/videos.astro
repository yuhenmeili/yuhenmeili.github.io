---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import VideoCard from '../components/VideoCard.astro';
import { VIDEOS, CATEGORIES, categoryLabel } from '../data/videos';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Videos - MORROW"
  description="Real-time graphics showreel: rendering engines, GIS & digital twins, BIM/CAD, vehicle HMI and web 3D demos."
>
  <Navigation />

  <main class="videos-page">
    <div class="container">
      <header class="videos-header">
        <h1 class="page-title">Videos</h1>
        <p class="page-subtitle">
          {VIDEOS.length} real-time graphics demos — engines, digital twins, vehicle HMI and more
        </p>
      </header>

      <nav class="filter-bar" aria-label="视频分类">
        <button class="filter-tab active" data-filter="all">
          全部 <span class="count">{VIDEOS.length}</span>
        </button>
        {CATEGORIES.map((cat) => (
          <button class="filter-tab" data-filter={cat.id}>
            {cat.label} <span class="count">{VIDEOS.filter((v) => v.category === cat.id).length}</span>
          </button>
        ))}
      </nav>
      <p class="category-hint" id="category-hint">All works, latest techniques first</p>

      <div class="videos-grid" id="videos-grid">
        {VIDEOS.map((video) => (
          <VideoCard video={video} categoryLabel={categoryLabel(video.category)} />
        ))}
      </div>
    </div>
  </main>

  <dialog class="video-modal" id="video-modal">
    <div class="modal-inner">
      <button class="modal-close" id="modal-close" aria-label="关闭">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <video id="modal-player" controls playsinline preload="metadata"></video>
      <div class="loading-overlay" id="modal-loading" hidden>
        <div class="spinner"></div>
        <div class="loading-bar"><span id="loading-fill"></span></div>
        <p class="loading-text" id="loading-text">加载中…</p>
      </div>
      <p class="modal-title" id="modal-title"></p>
    </div>
  </dialog>
</BaseLayout>

<style>
  .videos-page {
    min-height: 100vh;
    padding: calc(var(--nav-height) + 2rem) 2rem 5rem;
  }

  .container {
    max-width: 1320px;
    margin: 0 auto;
  }

  .videos-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-dim);
    max-width: 560px;
    margin: 0 auto;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }

  .filter-tab {
    padding: 0.5rem 1rem;
    background: rgba(30, 41, 59, 0.55);
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    color: var(--color-text-dim);
    font-family: var(--font-body);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-tab:hover {
    color: var(--color-text);
    border-color: var(--color-primary);
  }

  .filter-tab.active {
    background: rgba(59, 130, 246, 0.15);
    border-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: 600;
  }

  .filter-tab .count {
    opacity: 0.65;
    font-size: 0.8125rem;
    margin-left: 0.125rem;
  }

  .category-hint {
    text-align: center;
    color: var(--color-text-dim);
    font-size: 0.9rem;
    margin-bottom: 2rem;
    min-height: 1.4em;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .video-card[hidden] {
    display: none;
  }

  /* Modal player */
  .video-modal {
    /* the global `* { margin: 0 }` would otherwise pin the dialog top-left */
    margin: auto;
    width: min(960px, 92vw);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-bg-darker);
    color: var(--color-text);
  }

  .video-modal::backdrop {
    background: rgba(2, 6, 23, 0.85);
    backdrop-filter: blur(6px);
  }

  .modal-inner {
    position: relative;
    padding: 1rem;
  }

  .modal-inner video {
    width: 100%;
    max-height: 72vh;
    border-radius: 0.5rem;
    background: black;
  }

  /* Loading overlay for large files */
  .loading-overlay {
    position: absolute;
    left: 1rem;
    right: 1rem;
    top: 1rem;
    height: min(72vh, calc(100vw - 4rem));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border-radius: 0.5rem;
    background: rgba(2, 6, 23, 0.72);
    backdrop-filter: blur(3px);
    z-index: 1;
  }

  .loading-overlay[hidden] {
    display: none;
  }

  .spinner {
    width: 44px;
    height: 44px;
    border: 3px solid rgba(148, 163, 184, 0.3);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .loading-bar {
    width: min(360px, 70%);
    height: 5px;
    border-radius: 3px;
    background: rgba(148, 163, 184, 0.25);
    overflow: hidden;
  }

  .loading-bar span {
    display: block;
    width: 0%;
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent-purple));
    transition: width 0.25s ease;
  }

  .loading-text {
    font-size: 0.9rem;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .modal-title {
    margin-top: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 600;
    text-align: center;
  }

  .modal-close {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 1;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-bg-card);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .modal-close:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .videos-page {
      padding-top: calc(var(--nav-height) + 1rem);
    }

    .videos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initVideosPage() {
    const grid = document.getElementById('videos-grid');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const hint = document.getElementById('category-hint');
    const modal = document.getElementById('video-modal') as HTMLDialogElement | null;
    const player = document.getElementById('modal-player') as HTMLVideoElement | null;
    const modalTitle = document.getElementById('modal-title');
    const closeBtn = document.getElementById('modal-close');

    if (!grid) return;

    // Category filtering
    tabs.forEach((tab) => {
      if (tab.dataset.bound) return;
      tab.dataset.bound = '1';
      tab.addEventListener('click', () => {
        const filter = tab.dataset.filter ?? 'all';
        tabs.forEach((t) => t.classList.toggle('active', t === tab));
        grid.querySelectorAll<HTMLElement>('.video-card').forEach((card) => {
          const show = filter === 'all' || card.dataset.category === filter;
          card.hidden = !show;
          // Pause any running previews of hidden cards
          const preview = card.querySelector('video');
          if (!show && preview) {
            preview.pause();
          }
        });
        if (hint) {
          const label = tab.textContent?.replace(/\d+/, '').trim() ?? '';
          hint.textContent =
            filter === 'all' ? 'All works, latest techniques first' : `${label} — 全部演示`;
        }
      });
    });

    // Hover previews (desktop)
    grid.querySelectorAll<HTMLElement>('.video-card').forEach((card) => {
      if (card.dataset.previewBound) return;
      card.dataset.previewBound = '1';
      const preview = card.querySelector<HTMLVideoElement>('video.preview');
      if (!preview) return;

      card.addEventListener('mouseenter', () => {
        if (card.hidden) return;
        if (!preview.src) preview.src = preview.dataset.src ?? '';
        preview.play().catch(() => {});
      });
      card.addEventListener('mouseleave', () => {
        preview.pause();
        preview.currentTime = 0;
      });
    });

    // Modal playback
    const loading = document.getElementById('modal-loading');
    const loadingFill = document.getElementById('loading-fill');
    const loadingText = document.getElementById('loading-text');
    if (modal && player && !modal.dataset.bound) {
      modal.dataset.bound = '1';

      const showLoading = (text) => {
        if (!loading) return;
        loading.hidden = false;
        if (loadingFill) loadingFill.style.width = '0%';
        if (loadingText) loadingText.textContent = text ?? '加载中…';
      };

      const updateBufferProgress = () => {
        if (!loading || loading.hidden) return;
        const dur = player.duration;
        if (dur > 0 && player.buffered.length > 0) {
          const pct = Math.min(
            100,
            Math.round((player.buffered.end(player.buffered.length - 1) / dur) * 100),
          );
          if (loadingFill) loadingFill.style.width = `${pct}%`;
          if (loadingText) loadingText.textContent = `加载中 ${pct}%`;
        }
      };

      player.addEventListener('progress', updateBufferProgress);
      player.addEventListener('canplay', () => {
        if (loading) loading.hidden = true;
      });
      player.addEventListener('playing', () => {
        if (loading) loading.hidden = true;
      });
      player.addEventListener('waiting', () => showLoading('缓冲中…'));

      const openModal = (card: HTMLElement) => {
        const title = card.querySelector('.title')?.textContent ?? '';
        if (modalTitle) modalTitle.textContent = title;
        if (player.src !== card.dataset.videoSrc) {
          player.src = card.dataset.videoSrc ?? '';
        }
        showLoading('加载中…');
        modal.showModal();
        player.play().catch(() => {});
      };

      grid.querySelectorAll<HTMLElement>('.video-card').forEach((card) => {
        if (card.dataset.modalBound) return;
        card.dataset.modalBound = '1';
        card.addEventListener('click', () => openModal(card));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openModal(card);
          }
        });
      });

      closeBtn?.addEventListener('click', () => modal.close());
      modal.addEventListener('close', () => {
        player.pause();
        player.removeAttribute('src');
        player.load();
      });
      // Click on backdrop closes
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.close();
      });
    }
  }

  document.addEventListener('astro:page-load', initVideosPage);
</script>
